# Plantilla de credenciales. NO renombrar a secrets.toml con datos reales
# dentro del repositorio: ese fichero está en .gitignore por algo.
#
# En Streamlit Cloud esto NO se sube como fichero: se pega el contenido en
#   Manage app -> Settings -> Secrets
#
# Cómo obtener los valores:
#   1. console.cloud.google.com -> crear proyecto
#   2. APIs y servicios -> habilitar "Google Sheets API"
#   3. Credenciales -> Crear credenciales -> Cuenta de servicio
#   4. En la cuenta creada: Claves -> Añadir clave -> JSON (se descarga)
#   5. Copiar cada campo del JSON descargado aquí abajo
#   6. Crear la hoja de cálculo en Google Sheets y COMPARTIRLA con el
#      client_email de la cuenta de servicio, con permiso de Editor
#   7. El sheet_id es el tramo de la URL entre /d/ y /edit

[registro]
sheet_id = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"

[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "..."
# Ojo: la clave va entre comillas triples y conserva los \n literales.
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""
client_email = "registro-demo@tu-proyecto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
