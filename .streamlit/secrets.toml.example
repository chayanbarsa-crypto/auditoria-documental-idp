# Plantilla de credenciales. El fichero real (secrets.toml) está en
# .gitignore: NUNCA debe subirse al repositorio.
#
# En Streamlit Cloud esto NO se sube como fichero: se pega el contenido en
#   Manage app -> Settings -> Secrets
#
# Cómo obtener la contraseña de aplicación de Gmail:
#   1. La cuenta debe tener la VERIFICACIÓN EN DOS PASOS activada
#      (myaccount.google.com -> Seguridad). Sin 2FA no existe la opción.
#   2. Ve a  myaccount.google.com/apppasswords
#   3. Crea una contraseña con el nombre que quieras ("demo IDP")
#   4. Google muestra 16 letras en 4 bloques. Pégalas aquí SIN espacios.
#
# Ojo: una contraseña de aplicación da acceso al envío de correo de esa
# cuenta. Si se filtra, revócala desde la misma pantalla.

[email]
remitente = "avc.jordy@gmail.com"      # cuenta que envía el aviso
password_app = "abcdefghijklmnop"      # 16 caracteres, sin espacios
destinatario = "avc.jordy@gmail.com"   # opcional: por defecto, el remitente
servidor = "smtp.gmail.com"            # opcional
puerto = 465                           # opcional (SSL)
